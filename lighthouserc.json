{
  "ci": {
    "collect": {
      "staticDistDir": "dist/deshbhakt/browser",
      "url": ["/index.html", "/hi/index.html", "/mr/index.html", "/about/index.html", "/news/index.html"],
      "numberOfRuns": 1,
      "settings": { "preset": "mobile" }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.9 }]
      }
    }
  }
}
